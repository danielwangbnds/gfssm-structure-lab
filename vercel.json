{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npx --yes pnpm@11.25.0 install --frozen-lockfile",
  "buildCommand": "npx --yes pnpm@11.25.0 run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/draco/draco_decoder.wasm",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/wasm"
        }
      ]
    },
    {
      "source": "/assets/iss-nasa.glb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "model/gltf-binary"
        }
      ]
    },
    {
      "source": "/assets/fonts/IBMPlexMono-Regular.ttf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "font/ttf"
        }
      ]
    }
  ]
}
